{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "1.0.0",
  "description": "Визуальный менеджер закладок на новой вкладке: доски, drag-and-drop, быстрое сохранение, приватный режим.",
  "permissions": ["storage", "bookmarks", "tabs"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Сохранить текущую вкладку в TabVault"
    }
  },
  "action": {
    "default_title": "Открыть TabVault"
  }
}
